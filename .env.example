# Server-only Neon pooled connection URL. Never prefix these values with PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional direct URL for migrations (without -pooler in the hostname).
DATABASE_URL_DIRECT=
BETTER_AUTH_URL=http://127.0.0.1:5173
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
RESEND_API_KEY=
# Use a sender on your verified Resend domain.
AUTH_EMAIL_FROM=Aksara <signin@example.com>
